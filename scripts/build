#!/bin/sh
# Builds yf.
#
#   dist/dev/    the source tree, built: yf.css, yf.js, fonts/, icons/. This is what
#                scripts/release freezes into releases/vX.Y.Z/.
#   dist/site/   what gets deployed to https://ds.yoanfaure.com:
#                  v*/         every frozen release, copied from releases/
#                  index.html  the docs page, linking the LATEST release
#                  _docs/      the docs page's own css and js
#                  404.html    the not-found page
#                  _headers    Cloudflare headers (CORS and caching for releases, a strict CSP for the docs)
#                  dev/        a copy of dist/dev, in local builds only, never in production
#
# usage: scripts/build [--production] [--dev] [--dev-only] [--serve [port]]
#   --production   the deploy build. Fails if releases/ has no release, and leaves out dev/.
#   --dev          point the docs at /dev/ (the source tree) even when releases exist, to
#                  preview unreleased changes. Without a release the docs point at /dev/ anyway.
#   --dev-only     build dist/dev and stop (scripts/release uses this).
#   --serve [port] build, then serve dist/site on http://127.0.0.1:PORT (default 4300).
#
# POSIX sh and awk. No dependencies.
set -eu
cd "$(dirname "$0")/.."
export LC_ALL=C

usage() {
  sed -n '/^# usage:/,/^# POSIX/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

die() {
  echo "build: $*" >&2
  exit 1
}

production=0
docs_dev=0
dev_only=0
serve=0
port=4300
while [ "$#" -gt 0 ]; do
  case $1 in
    --production) production=1 ;;
    --dev) docs_dev=1 ;;
    --dev-only) dev_only=1 ;;
    --serve)
      serve=1
      case ${2-} in
        '' | *[!0-9]*) ;;
        *)
          port=$2
          shift
          ;;
      esac
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "build: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

[ "$production" = 1 ] && [ "$docs_dev" = 1 ] && die "--production and --dev cannot be combined: production never serves /dev/"

version=$(tr -d ' \t\r\n' < VERSION)
printf '%s' "$version" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' ||
  die "VERSION must hold X.Y.Z, not '$version'"

# ---------- dist/dev ----------

dev=dist/dev
rm -rf "$dev"
mkdir -p "$dev/fonts" "$dev/icons"

cat src/css/*.css > "$dev/yf.css"
if ls src/js/*.js > /dev/null 2>&1; then
  cat src/js/*.js > "$dev/yf.js"
else
  : > "$dev/yf.js"
fi
cp src/fonts/* "$dev/fonts/"
if ls src/icons/* > /dev/null 2>&1; then cp src/icons/* "$dev/icons/"; fi

echo "built $dev ($(wc -c < "$dev/yf.css" | tr -d ' ') bytes css, $(wc -c < "$dev/yf.js" | tr -d ' ') bytes js)"

[ "$dev_only" = 1 ] && exit 0

# ---------- the releases ----------
# releases/vX.Y.Z/ folders, oldest first by semver. Anything else in releases/ is ignored.

releases=$(
  for d in releases/v*/; do
    [ -d "$d" ] || continue
    name=${d#releases/v}
    name=${name%/}
    if printf '%s' "$name" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
      echo "$name"
    else
      echo "build: ignoring releases/v$name (not a semver folder)" >&2
    fi
  done | sort -t. -k1,1n -k2,2n -k3,3n
)
latest=$(printf '%s\n' "$releases" | tail -n 1)

if [ "$production" = 1 ]; then
  if [ -z "$latest" ]; then
    {
      echo "build: no release in releases/, and a production build needs one."
      echo "       Run scripts/release X.Y.Z, commit releases/vX.Y.Z, then build again."
    } >&2
    exit 1
  fi
  for v in $releases; do
    for f in yf.css yf.js icons/yf-icons.svg RELEASE; do
      [ -f "releases/v$v/$f" ] || die "releases/v$v is missing $f"
    done
  done
fi

# ---------- dist/site ----------

site=dist/site
work=dist/.build
rm -rf "$site" "$work"
mkdir -p "$site/_docs" "$work"

for v in $releases; do cp -R "releases/v$v" "$site/v$v"; done
[ "$production" = 1 ] || cp -R "$dev" "$site/dev"

# What the docs link and describe: the latest release, or the source tree when there is
# none (or --dev). Tokens, contrast ratios and the icon grid are read from that same copy
# of yf.css, so the page cannot disagree with what it links.
if [ "$production" = 0 ] && { [ "$docs_dev" = 1 ] || [ -z "$latest" ]; }; then
  base=/dev
  label=dev
  shown=$version
  notice=1
else
  base=/v$latest
  label=v$latest
  shown=$latest
  notice=0
fi
cdn=https://ds.yoanfaure.com/v$shown
tree=$site$base

[ -f "$tree/yf.css" ] || die "$tree/yf.css is missing"

tokens() { # tokens MODE [REGEX]: one fragment from the token blocks
  if [ -n "${2-}" ]; then
    awk -v mode="$1" -v re="$2" -f scripts/lib/tokens.awk "$tree/yf.css" > "$work/$1.html"
  else
    awk -v mode="$1" -f scripts/lib/tokens.awk "$tree/yf.css" > "$work/$1.html"
  fi
  [ -s "$work/$1.html" ] || die "no $1 fragment came out of $tree/yf.css"
}

tokens colour
tokens status
tokens series
tokens space
tokens type
awk -v mode=kv -v re='^(weight|leading|tracking)-' -f scripts/lib/tokens.awk "$tree/yf.css" > "$work/type-more.html"
awk -v mode=kv -v re='^(radius|radius-layout|border|border-strong|control-h|measure|container|gutter)$' -f scripts/lib/tokens.awk "$tree/yf.css" > "$work/shape.html"
awk -v mode=kv -v re='^(dur|dur-fast|dur-slow|ease-out|ease-in)$' -f scripts/lib/tokens.awk "$tree/yf.css" > "$work/motion.html"
awk -f scripts/lib/icons.awk "$tree/icons/yf-icons.svg" > "$work/icons.html"
icon_count=$(grep -c '<symbol ' "$tree/icons/yf-icons.svg")

# the table of released versions, newest first
{
  if [ -z "$releases" ]; then
    echo '<p class="yf-muted">No release yet. scripts/release X.Y.Z freezes the first one.</p>'
  else
    echo '<div class="yf-table-wrap" tabindex="0" role="region" aria-label="Released versions">'
    echo '<table class="yf-table">'
    echo '<thead><tr><th scope="col">version</th><th scope="col">released</th><th scope="col">files</th></tr></thead>'
    echo '<tbody>'
    first=1
    for v in $(printf '%s\n' "$releases" | sort -t. -k1,1nr -k2,2nr -k3,3nr); do
      date=$(sed -n 's/^date: \([0-9-]*\).*/\1/p' "releases/v$v/RELEASE" 2> /dev/null | head -n 1)
      tag=
      [ "$first" = 1 ] && tag=' <span class="yf-status">latest</span>'
      first=0
      printf '<tr><th scope="row"><span class="yf-mono">v%s</span>%s</th><td class="yf-num">%s</td>' "$v" "$tag" "${date:--}"
      printf '<td><a href="/v%s/yf.css">yf.css</a>, <a href="/v%s/yf.js">yf.js</a>, <a href="/v%s/icons/yf-icons.svg">icons</a>, <a href="/v%s/RELEASE">RELEASE</a></td></tr>\n' "$v" "$v" "$v" "$v"
    done
    echo '</tbody></table></div>'
  fi
} > "$work/releases.html"

if [ "$notice" = 1 ]; then
  cat > "$work/dev-notice.html" << 'EOF'
<div class="yf-banner yf-banner--info" role="note"><span class="yf-banner__icon" aria-hidden="true"></span><div class="yf-banner__body"><p class="yf-banner__title">Previewing the source tree</p><p>This page links /dev/, built from src/ and never deployed. Release a version to publish it.</p></div></div>
EOF
else
  : > "$work/dev-notice.html"
fi

# the page: expand the examples, then fill the tokens
subst() { # subst IN OUT
  sed \
    -e "s|{{BASE}}|$base|g" \
    -e "s|{{CDN}}|$cdn|g" \
    -e "s|{{VERSION}}|$label|g" \
    -e "s|{{VERSION_SHOWN}}|v$shown|g" \
    -e "s|{{ICON_COUNT}}|$icon_count|g" \
    "$1" > "$2"
  if grep -n '{{[A-Za-z_]*}}' "$2" > /dev/null; then
    grep -n '{{[A-Za-z_]*}}' "$2" | head -5 >&2
    die "an unfilled {{token}} is left in $2"
  fi
}

awk -v incdir="$work" -f scripts/lib/examples.awk docs/index.html > "$work/index.expanded.html"
subst "$work/index.expanded.html" "$site/index.html"
subst docs/404.html "$site/404.html"
cp docs/docs.css docs/docs.js "$site/_docs/"

# ---------- _headers ----------
# Cloudflare Workers static assets format. Matching rules are merged, and a header set by
# two of them is joined with a comma, so no two rules here overlap. One splat per rule.

write_headers() {
  cat << 'EOF'
# Generated by scripts/build. Do not edit.

# The docs page proves yf works under a strict CSP: no inline script, no inline style.
/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# The docs page's own css and js: not versioned, so they revalidate.
/_docs/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate

EOF
  for v in $releases; do
    cat << EOF
# v$v is frozen: it never changes, so it caches for a year. Apps on other origins load
# the css, js and fonts cross-origin, hence CORS and a cross-origin resource policy.
/v$v/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

EOF
  done
  if [ "$production" = 0 ]; then
    cat << 'EOF'
# Local builds only: the unreleased source tree. Never deployed.
/dev/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff
EOF
  fi
}

write_headers > "$site/_headers"
rules=$(grep -c '^/' "$site/_headers")
[ "$rules" -le 100 ] ||
  die "_headers has $rules rules and Cloudflare allows 100: replace the per-release rules with one /v* rule"

rm -rf "$work"

echo "built $site: docs link $base/ ($label), releases: $(echo $releases | tr ' ' ',' | sed 's/^$/none/')$([ "$production" = 1 ] || echo ', plus /dev/')"

if [ "$serve" = 1 ]; then
  exec scripts/serve "$port"
fi
